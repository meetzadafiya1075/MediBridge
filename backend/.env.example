# MongoDB connection string (e.g. MongoDB Atlas cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/hospital_db?retryWrites=true&w=majority

# Secret key used for signing JWT authentication tokens
JWT_SECRET=replace_with_a_secure_random_secret_key

# Port (optional, defaults to 5000 locally; set automatically by Render in cloud)
PORT=5000
