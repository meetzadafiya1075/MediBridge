# In local development, you can leave this empty (Vite dev server proxies /api to http://localhost:5000)
# VITE_API_URL=http://localhost:5000/api

# For production deployment on Vercel, set this to your Render backend URL:
# VITE_API_URL=https://<your-render-service-name>.onrender.com/api
VITE_API_URL=
